<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_record"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_plus"
        android:shortcutShortLabel="@string/shortcut_record"
        android:shortcutLongLabel="@string/shortcut_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.maibill.app"
            android:targetClass="com.maibill.app.MainActivity">
            <extra android:name="goto_record" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>

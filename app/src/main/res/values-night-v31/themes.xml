<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色 + Android 12+：启动屏同色，且状态栏图标用浅色 -->
    <style name="Theme.MaiBill" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:windowSplashScreenBackground">@color/app_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
